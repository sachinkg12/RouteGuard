# Copy this file to .env only if you are running a config that opts into an
# external provider. Leave unused values blank and never commit real keys.

# Used by configs/experiment_llm_paper*.yaml and experiment_llm_sample.yaml
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TOGETHER_API_KEY=

# Used by configs/experiment_llm_unquantized*.yaml
DEEPINFRA_API_KEY=

# Supported by the generic OpenAI-compatible client when a custom config points
# at the corresponding provider endpoint.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GROQ_API_KEY=
